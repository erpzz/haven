[Unit]
Description=Haven Core Model Lab (private loopback UI)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/projects/haven/labs/model-lab
ExecStart=/usr/bin/python3 %h/projects/haven/labs/model-lab/server.py --port 8877 --data-dir %h/.local/share/haven-model-lab --launch-file %h/.local/state/haven-model-lab/launch-url
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
